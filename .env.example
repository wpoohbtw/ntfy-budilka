# BotFather token and your numeric Telegram user ID.
BOT_TOKEN=
ADMIN_ID=
# API credentials of the Telethon application (my.telegram.org).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Session file (created automatically after phone/code/2FA login on first start).
# Relative paths are resolved from this project. An existing session can be reused.
TELETHON_SESSION=data/watcher.session
# Alternative: an already authorized Telethon StringSession.
# Leave empty for interactive first login and automatic saving to the file above.
TELETHON_STRING_SESSION=
DATABASE_PATH=data/bot.sqlite3
# Allow a self-hosted ntfy server on a local/private IP network.
NTFY_ALLOW_PRIVATE_HOSTS=false
# HTTPS is required by default. Enable only for your trusted local ntfy server.
NTFY_ALLOW_HTTP=false
